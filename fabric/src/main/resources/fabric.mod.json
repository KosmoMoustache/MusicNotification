	"accessWidener": "${mod_id}.aw",
	"depends": {
		"minecraft": "${fabric_mc_range}",
		"fabricloader": ">=${floader}",
		"fabric-command-api-v2": "*",
		"cloth-config": ">=${cloth_config}"
	},
	"recommends": {
		"modmenu": "*"
	}
